      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "rainfall = [\"high\",\"high\",\"high\",\"low\",\"low\",\"low\"]\n",
        "soiltype = [\"loamy\",\"sandy\",\"clay\",\"loamy\",\"sandy\",\"clay\"]\n",
        "yeild = [\"good\",\"good\",\"good\",\"poor\",\"poor\",\"good\",]\n",
        "\n",
        "def rone(df):\n",
        "    col = list(df.columns)\n",
        "    target = col[-1]\n",
        "    length = len(df[target])\n",
        "    resPer = None\n",
        "    res = \"\"\n",
        "    for i in col[:-1]:\n",
        "        currError = 0\n",
        "        currCol = set(df[i])\n",
        "        for j in currCol:\n",
        "            temp = df[df[i] == j][target].value_counts()\n",
        "            if len(temp) > 0:\n",
        "                currError += temp.sum() - temp.max()\n",
        "        if resPer == None:\n",
        "            resPer = currError/length\n",
        "            res = i\n",
        "        elif currError/length < resPer:\n",
        "            resPer = currError/length\n",
        "            res = i\n",
        "    print(f\"The feature '{res}' is selected with error rate of {resPer*100:.4f}%\")\n",
        "\n",
        "\n",
        "data = {\"rainfall\":rainfall, \"soiltype\":soiltype, \"yeild\":yeild}\n",
        "df = pd.DataFrame(data)\n",
        "rone(df)\n"
